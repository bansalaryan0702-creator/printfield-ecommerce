{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build && npm prune --omit=dev",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    { "source": "/categories/", "destination": "/categories", "permanent": true },
    { "source": "/about/", "destination": "/about", "permanent": true },
    { "source": "/faq/", "destination": "/faq", "permanent": true },
    { "source": "/contact/", "destination": "/contact", "permanent": true },
    { "source": "/rating/", "destination": "/rating", "permanent": true },
    { "source": "/custom-printing/", "destination": "/custom-printing", "permanent": true },
    { "source": "/printing-whitefield/", "destination": "/printing-whitefield", "permanent": true },
    { "source": "/printing-itpl/", "destination": "/printing-itpl", "permanent": true },
    { "source": "/printing-brookefield/", "destination": "/printing-brookefield", "permanent": true },
    { "source": "/printing-marathahalli/", "destination": "/printing-marathahalli", "permanent": true },
    { "source": "/terms/", "destination": "/terms", "permanent": true },
    { "source": "/privacy/", "destination": "/privacy", "permanent": true },
    { "source": "/checkout/", "destination": "/checkout", "permanent": true },
    { "source": "/login/", "destination": "/login", "permanent": true },
    { "source": "/forgot-password/", "destination": "/forgot-password", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "printfieldonline.com" }], "destination": "https://www.printfieldonline.com/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/sitemap.xml", "destination": "/api" },
    { "source": "/xiomi", "destination": "/api" },
    { "source": "/alanwalker", "destination": "/api" },
    { "source": "/wp-admin", "destination": "/api" },
    { "source": "/wp-content", "destination": "/api" },
    { "source": "/wp-includes", "destination": "/api" },
    { "source": "/wordpress", "destination": "/api" },
    { "source": "/reviews", "destination": "/api" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/categories", "destination": "/index.html" },
    { "source": "/category/(.*)", "destination": "/index.html" },
    { "source": "/product/(.*)", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/rating", "destination": "/index.html" },
    { "source": "/custom-printing", "destination": "/index.html" },
    { "source": "/printing-whitefield", "destination": "/index.html" },
    { "source": "/printing-itpl", "destination": "/index.html" },
    { "source": "/printing-brookefield", "destination": "/index.html" },
    { "source": "/printing-marathahalli", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/checkout", "destination": "/index.html" },
    { "source": "/orders", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/forgot-password", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    }
  ]
}
