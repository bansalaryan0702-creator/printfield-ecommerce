{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store products",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "image": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "features": { "type": "array", "items": { "type": "string" } },
        "colors": { "type": "array" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name"]
    },
    "User": {
      "title": "User",
      "description": "User profiles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "savedAddresses": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["email", "role"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "total": { "type": "number" },
        "shippingAddress": { "type": "object" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "status", "total"]
    },
    "OrderItem": {
      "title": "OrderItem",
      "description": "Items in an order",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "customizations": { "type": "string" }
      },
      "required": ["productId", "quantity", "price"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin users",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": { "schema": { "$ref": "#/entities/Product" }, "description": "Products" },
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" }, "description": "Users" },
    "/orders/{orderId}": { "schema": { "$ref": "#/entities/Order" }, "description": "Orders" },
    "/orders/{orderId}/items/{itemId}": { "schema": { "$ref": "#/entities/OrderItem" }, "description": "Order items" },
    "/admins/{adminId}": { "schema": { "$ref": "#/entities/Admin" }, "description": "Global Admins" }
  }
}
